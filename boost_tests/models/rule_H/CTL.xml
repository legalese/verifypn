<?xml version="1.0"?>
<property-set xmlns="http://mcc.lip6.fr/">
  <property>
    <id>rule_H-CTLCardinality-00</id>
    <description>Every path marks s1, and s1 stays reachable; not an LTL formula.</description>
    <formula>
      <conjunction>
        <all-paths>
          <finally>
            <integer-le>
              <integer-constant>1</integer-constant>
              <tokens-count>
                <place>s1</place>
              </tokens-count>
            </integer-le>
          </finally>
        </all-paths>
        <all-paths>
          <globally>
            <exists-path>
              <finally>
                <integer-le>
                  <integer-constant>1</integer-constant>
                  <tokens-count>
                    <place>s1</place>
                  </tokens-count>
                </integer-le>
              </finally>
            </exists-path>
          </globally>
        </all-paths>
      </conjunction>
    </formula>
  </property>
  <property>
    <id>rule_H-CTLCardinality-01</id>
    <description>Every path reaches a marking of s1 from which s1 can be emptied again.</description>
    <formula>
      <all-paths>
        <finally>
          <conjunction>
            <integer-le>
              <integer-constant>1</integer-constant>
              <tokens-count>
                <place>s1</place>
              </tokens-count>
            </integer-le>
            <exists-path>
              <finally>
                <integer-le>
                  <tokens-count>
                    <place>s1</place>
                  </tokens-count>
                  <integer-constant>0</integer-constant>
                </integer-le>
              </finally>
            </exists-path>
          </conjunction>
        </finally>
      </all-paths>
    </formula>
  </property>
</property-set>
